# Copy to .env.local for a local run; on Vercel set these under Settings → Environment Variables.
# Never commit real values.

# The one password to log in with.
APP_PASSWORD=

# Supabase: the project and its service role key (Project Settings → API).
SUPABASE_URL=https://bjzufmvwldoltpitkrvx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# UniFi Site Manager API key (unifi.ui.com → Settings → API Keys).
UNIFI_API_KEY=

# Payter (MyPayter) login.
PAYTER_USERNAME=
PAYTER_PASSWORD=
PAYTER_DOMAIN=

# A second Payter account (another domain), and so on up to PAYTER_5_…; leave out what you do not have.
PAYTER_2_USERNAME=
PAYTER_2_PASSWORD=
PAYTER_2_DOMAIN=

# Optional: a long random string to sign logins with. Without it, the password and the Supabase key are used.
SESSION_SECRET=

# Only on your own computer: made-up figures, no UniFi, Payter or database needed.
# CI_DEMO=1
